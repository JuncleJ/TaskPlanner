@page
@model ErrorModel

@{
    ViewData["Title"] = "Ошибка";
}

<div class="text-center mt-5">
    <h1 class="text-danger">Что-то пошло не так</h1>

    <p class="mt-3">
        Во время обработки запроса произошла ошибка.
    </p>

    <a asp-page="/Index" class="btn btn-primary mt-3">
        На главную
    </a>
</div>
