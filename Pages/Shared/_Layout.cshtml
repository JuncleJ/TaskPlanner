<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskPlanner</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TaskPlanner.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">TaskPlanner</a>

            <div class="navbar-nav">
                <a class="nav-link" asp-page="/Index">Главная</a>
                <a class="nav-link" asp-page="/Tasks">Задачи</a>
                <a class="nav-link" asp-page="/Trash">Корзина</a>
            </div>
        </div>


        <div class="ms-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="me-3">
                    👤 @User.Identity.Name
                </span>

                <form method="post"
                    asp-page="/Logout"
                    class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        Выйти
                    </button>
                </form>
            }
            else
            {
                <a asp-page="/Login" class="btn btn-primary btn-sm">
                    Войти
                </a>
            }
        </div>
    </nav>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TaskPlanner - <a asp-area="" asp-page="/Privacy">О проекте</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
